{
  "name": "dsh-message-pipeline",
  "version": "0.1.0",
  "type": "module",
  "description": "Named pipelines for scoped cross-session messaging in DeepSeek Harness (DSH)",
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "client.js",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "messaging",
    "multi-agent",
    "cross-session",
    "workspace"
  ],
  "author": "Bismuth-209",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bismuth-209/DSHMessagePipeline.git"
  },
  "homepage": "https://github.com/Bismuth-209/DSHMessagePipeline#readme",
  "bugs": {
    "url": "https://github.com/Bismuth-209/DSHMessagePipeline/issues"
  }
}
